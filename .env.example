# Public contact details
NEXT_PUBLIC_SITE_URL=https://fst.ikanisa.com

# Approved public legal and professional details.
NEXT_PUBLIC_LEGAL_NAME=FST Management Services Limited
NEXT_PUBLIC_COMPANY_REGISTRATION_NUMBER=C 21500
NEXT_PUBLIC_VAT_NUMBER=MT 1409 8221
NEXT_PUBLIC_REGISTERED_ADDRESS=144/9, Palazzo Marian, Marina Street, Pietà PTA 9043, Malta
NEXT_PUBLIC_CONTACT_EMAIL=info@ikanisa.com
NEXT_PUBLIC_COMPLAINTS_EMAIL=info@ikanisa.com
NEXT_PUBLIC_ACCOUNTANCY_BOARD_REGISTRATION=Registered with the Malta Accountancy Board
NEXT_PUBLIC_RESPONSIBLE_PRINCIPAL=Joseph Azzopardi
NEXT_PUBLIC_PRINCIPAL_WARRANT_NUMBER=

# Rwanda public contact details. The WhatsApp number below is the approved
# default for general enquiries and catalogue requests.
NEXT_PUBLIC_RW_CONTACT_EMAIL=
NEXT_PUBLIC_RW_WHATSAPP_DISPLAY=+250795588248
NEXT_PUBLIC_RW_SERVICE_WHATSAPP_DISPLAY=+250795588248

# Replace with the final Google Calendar Appointment Schedule URL.
# Without it, the website opens a pre-addressed Google Calendar event.
NEXT_PUBLIC_GOOGLE_BOOKING_URL=

# Verified FST company profile only. Leave blank until confirmed.
NEXT_PUBLIC_LINKEDIN_URL=

# Native Google Calendar API booking. The Google account must grant offline
# Calendar access and the selected calendar must permit event creation.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_TIMEZONE=Europe/Malta

# Jurisdiction-specific operational routing. Rwanda booking fails closed until
# its calendar and recipients are configured. Recipients are comma-separated.
MT_GOOGLE_CALENDAR_ID=
MT_GOOGLE_CALENDAR_TIMEZONE=Europe/Malta
MT_BOOKING_RECIPIENTS=
RW_GOOGLE_CALENDAR_ID=
RW_GOOGLE_CALENDAR_TIMEZONE=Africa/Kigali
RW_BOOKING_RECIPIENTS=

# Cloudflare D1 binding required by POST /api/v1/enquiries.
# Create the database, add a DB binding in wrangler.jsonc, then apply the
# generated Drizzle migration before enabling the secure enquiry form.

# Google Analytics 4 measurement ID, for example G-XXXXXXXXXX.
# Analytics stays off when blank and loads only after visitor consent.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Google Search Console HTML-tag verification token.
GOOGLE_SITE_VERIFICATION=
