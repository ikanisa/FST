{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fst-advisory",
  "workers_dev": false,
  "compatibility_date": "2026-05-22",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "main": "./worker/index.ts",
  "routes": [
    {
      "pattern": "fst.ikanisa.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fst-advisory-production",
      "database_id": "da9a9ce0-fd39-44d1-871a-d4411cc32992",
      "migrations_dir": "drizzle"
    }
  ],
  "images": {
    "binding": "IMAGES"
  }
}
